# Copia este archivo a .env y completa con los valores reales de tu proyecto Supabase.
# NUNCA subas el archivo .env con claves reales al repositorio.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Clave pública VAPID para notificaciones push (Web Push API). Es pública por
# diseño (viaja al navegador en pushManager.subscribe()); la clave PRIVADA
# nunca va acá ni en ningún archivo del frontend, solo como secreto de la
# Edge Function "send-push" en Supabase. Ver DEPLOYMENT.md, sección
# "Notificaciones push".
VITE_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
