node_modules
dist
dist-ssr
*.local

# Variables de entorno reales: nunca se versionan. Solo .env.example, con
# valores de ejemplo.
.env
.env.*
!.env.example

# Claves y certificados.
*.pem
*.key
*.p8
*.p12
*.pfx

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vscode/*
!.vscode/extensions.json
.idea

# Configuración local de herramientas del editor: cada clon la excluye en
# .git/info/exclude (no se versiona en este archivo).

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

dev-dist
*.tsbuildinfo

supabase/.temp
supabase/.branches
.vercel

# Copias originales de logos en la raiz (fuente de donde se copiaron a
# public/logos/, que es lo que la app realmente usa) — no hace falta
# versionarlas dos veces.
/Logo escuela.png
/LG INFORMATICA Y ESTADÍSTICA.png

# Salidas generadas/temporales que no deben versionarse (reportes de prueba,
# capturas, backups de base de datos, exports puntuales).
*.pdf
!public/**/*.pdf
*.bak
*.backup
*.dump
*.sql.gz
/screenshots/
/exports/
*.log

# El manual de usuario es material institucional externo: vive fuera del repositorio.
# Por si una copia llega a esta carpeta, no se versiona.
MANUAL_USUARIO_SIGER4*
