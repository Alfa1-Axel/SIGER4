{
  "name": "SIGER4",
  "private": true,
  "version": "1.19.0",
  "type": "module",
  "description": "SIGER4 - Sistema Informático de GEstión de la Regional 4",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "build": "npm run build --workspace frontend --",
    "preview": "npm run preview --workspace frontend --",
    "lint": "npm run lint --workspace frontend --",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "npm run test:ui --",
    "test:backend": "npm run test:release && npm run test:db",
    "test:ui": "node tests/frontend/ui/check.mjs",
    "test:release": "node tests/backend/release/check.mjs",
    "test:db": "node tests/backend/db/run.mjs",
    "security:check": "node backend/scripts/security-check.mjs",
    "release:announce": "node backend/scripts/announce-release.mjs"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "minimatch": "^10.2.5",
    "ejs": "^6.0.1"
  }
}
