# Copia este archivo a .env y completa con los valores reales de tu proyecto Supabase.
# NUNCA subas el archivo .env con claves reales al repositorio.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# La clave de la API de IA (Gemini) NO va en este archivo ni en ningún otro
# archivo del frontend: se configura como secreto de la Edge Function
# "analyze-report" directamente en Supabase (Project Settings > Edge Functions
# > Secrets, o `supabase secrets set GEMINI_API_KEY=...`). Ver DEPLOYMENT.md,
# sección "Análisis IA de reportes".
